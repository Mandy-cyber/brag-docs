{
  "name": "brag-docs",
  "version": "0.1.0",
  "description": "CLI for maintaining a running brag document of professional accomplishments",
  "type": "module",
  "bin": {
    "brag": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
